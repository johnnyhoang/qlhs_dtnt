# Server
NODE_ENV=development
PORT=3500

# Database
# Supabase / production: prefer a single DATABASE_URL
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# Local PostgreSQL fallback (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=qlhs_user
DB_PASSWORD=change_me
DB_NAME=qlhs_db
DB_SSL=false

# Auth
JWT_SECRET=change_me
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://your-web-domain.vercel.app
ALLOW_VERCEL_PREVIEWS=true
