{
  "version": 2,
  "builds": [
    {
      "src": "server/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/src/index.ts"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)$",
      "dest": "web/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web/index.html"
    }
  ]
}
